# Application
APP_NAME=Employee CRUD API
APP_ENV=development
APP_PORT=8080
APP_VERSION=1.0.0

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=employee_db
DB_CHARSET=utf8mb4
DB_PARSETIME=True
DB_LOC=Local

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production